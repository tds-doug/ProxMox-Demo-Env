# config/defaults.env - factory defaults. Do not edit; override in config/demo.env.
# Format: KEY=VALUE only (parsed, never executed). No passwords belong here.

# --- Container identity -----------------------------------------------------
CTID=201
CT_HOSTNAME=demo-ai-01

# --- Resources --------------------------------------------------------------
CT_CORES=2
CT_MEMORY=4096        # MB
CT_SWAP=1024          # MB
CT_DISK=40            # GB
CT_ONBOOT=1
CT_NESTING=0          # set 1 only if systemd units fail to start (see docs/troubleshooting.md)

# --- Network ----------------------------------------------------------------
NETWORK_MODE=dhcp     # dhcp | static
BRIDGE=vmbr0
VLAN_TAG=
STATIC_IP=
STATIC_PREFIX=24
STATIC_GATEWAY=
STATIC_DNS=

# --- Storage ("auto" = discover and choose; see: ./deploy.sh storage) -------
STORAGE=auto
TEMPLATE_STORAGE=auto

# --- Access -----------------------------------------------------------------
ADMIN_USER=demoadmin
SSH_ALLOW_USERS=      # defaults to ADMIN_USER
ADMIN_SSH_PUBKEY=     # optional; password login stays enabled regardless
SSH_MGMT_SUBNET=      # optional CIDR; limits TCP/22 in the Proxmox firewall

# --- Software ---------------------------------------------------------------
PROFILE=ai-cli        # base | ai-cli
ENABLE_HTTPS=0        # 1 = self-signed cert on TCP/443 (no redirect, no HSTS)
DEMO_DB=1             # 1 = create demo database + restricted app account
UNATTENDED_UPGRADES=1 # security-pocket updates only, never auto-reboots

# --- Proxmox firewall -------------------------------------------------------
PROXMOX_FIREWALL=1    # write the per-container rules (does NOT touch host/datacenter policy)

# --- Behaviour --------------------------------------------------------------
NET_TIMEOUT=90        # seconds to wait for a DHCP lease
SNAPSHOT_AFTER_DEPLOY=0
ALLOW_OTHER_PVE=0     # 1 = permit Proxmox VE other than 9.x (untested)
