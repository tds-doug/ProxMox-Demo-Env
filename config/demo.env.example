# config/demo.env.example - copy to config/demo.env (git-ignored) and edit.
# Only list values that differ from config/defaults.env. NEVER put passwords here.

CTID=201
CT_HOSTNAME=demo-ai-01
ADMIN_USER=demoadmin
PROFILE=ai-cli

# Leave "auto" to let the factory pick, or name a storage from `./deploy.sh storage`
STORAGE=auto
TEMPLATE_STORAGE=auto

BRIDGE=vmbr0
#SSH_MGMT_SUBNET=192.168.1.0/24

# More headroom for heavier demos:
#CT_MEMORY=8192
#CT_CORES=4

# Static addressing instead of DHCP:
#NETWORK_MODE=static
#STATIC_IP=192.168.1.50
#STATIC_PREFIX=24
#STATIC_GATEWAY=192.168.1.1
#STATIC_DNS=192.168.1.1
